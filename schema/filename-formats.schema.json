{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/qoo-oji/qooMeta/main/schema/filename-formats.schema.json",
  "title": "qooMeta のファイル名のフォーマット(第 4 版)",
  "description": "既定値の全体、または base: builtin の差分。説明は docs/filename-format.md",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "qoometa.filename-formats"
    },
    "schemaVersion": {
      "const": 4
    },
    "revision": {
      "type": "string"
    },
    "base": {
      "const": "builtin",
      "description": "差分のファイルにだけ書く。同梱の既定値に重ねる"
    },
    "retiredIDs": {
      "$ref": "#/$defs/retiredIDs"
    },
    "aliases": {
      "$ref": "#/$defs/aliases"
    },
    "separators": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "著者の値を分ける文字列(既定は , ， 、)"
    },
    "defaultPreset": {
      "type": "string",
      "description": "本がプリセットを選ばなかったときに使う名前"
    },
    "presets": {
      "type": "object",
      "description": "名前を付けた型の並び。本ごと(実際にはフォルダごと)に選ぶ",
      "additionalProperties": {
        "$ref": "#/$defs/preset"
      }
    }
  },
  "$defs": {
    "preset": {
      "description": "1 つのプリセット。型の並びだけなら配列で書いてもよい",
      "oneOf": [
        {
          "$ref": "#/$defs/formats"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "formats": {
              "$ref": "#/$defs/formats"
            },
            "defaults": {
              "type": "object",
              "additionalProperties": false,
              "description": "名前に書かれていない欄に入れる値(名前から読めたときは触らない)",
              "properties": {
                "genre": {
                  "type": "string",
                  "minLength": 1
                },
                "event": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "info": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "型の並び。上から照合し、名前全体に一致した最初の型で読む。予約語は @title @author @genre @event @source @info @series @volume @ignore"
    },
    "retiredIDs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "廃止した規則の ID(既定値にだけ書く)"
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "旧 ID → 新 ID(既定値にだけ書く)"
    }
  }
}
