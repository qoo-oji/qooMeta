{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/qoo-oji/qooMeta/main/schema/filename-formats.schema.json",
  "title": "qooMeta のファイル名のフォーマット(第 2 版)",
  "description": "既定値の全体、または base: builtin の差分。説明は docs/rules.md",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "qoometa.filename-formats"
    },
    "schemaVersion": {
      "const": 2
    },
    "revision": {
      "type": "string"
    },
    "base": {
      "const": "builtin",
      "description": "差分のファイルにだけ書く。同梱の既定値に重ねる"
    },
    "retiredIDs": {
      "$ref": "#/$defs/retiredIDs"
    },
    "aliases": {
      "$ref": "#/$defs/aliases"
    },
    "reservedWords": {
      "type": "object",
      "properties": {
        "@genre": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "split": {
              "$ref": "#/$defs/charactersValue"
            }
          },
          "additionalProperties": false
        },
        "@event": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "split": {
              "$ref": "#/$defs/charactersValue"
            }
          },
          "additionalProperties": false
        },
        "@circle": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "split": {
              "$ref": "#/$defs/charactersValue"
            }
          },
          "additionalProperties": false
        },
        "@author": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "split": {
              "$ref": "#/$defs/charactersValue"
            }
          },
          "additionalProperties": false
        },
        "@title": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "split": {
              "$ref": "#/$defs/charactersValue"
            }
          },
          "additionalProperties": false
        },
        "@relation": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "split": {
              "$ref": "#/$defs/charactersValue"
            }
          },
          "additionalProperties": false
        },
        "@keywordA": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "split": {
              "$ref": "#/$defs/charactersValue"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "delimiters": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2
                      },
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "$replace": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2
                          },
                          "minItems": 2,
                          "maxItems": 2
                        }
                      }
                    },
                    "required": [
                      "$replace"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "protectedTokens": {
                "$ref": "#/$defs/patternsValue"
              },
              "formats": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  {
                    "$ref": "#/$defs/orderedOps"
                  }
                ]
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "delimiters": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2
                      },
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "$replace": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2
                          },
                          "minItems": 2,
                          "maxItems": 2
                        }
                      }
                    },
                    "required": [
                      "$replace"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "protectedTokens": {
                "$ref": "#/$defs/patternsValue"
              },
              "formats": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  {
                    "$ref": "#/$defs/orderedOps"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "description": "差分: プロファイルの ID をキーにする"
        }
      ]
    },
    "fallback": {
      "type": "object",
      "properties": {
        "simpleBrackets": {
          "type": "object",
          "properties": {
            "since": {
              "type": "integer",
              "minimum": 1
            },
            "required": {
              "type": "boolean"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "listRef": {
      "type": "string",
      "pattern": "^@list:[A-Za-z0-9]+$",
      "description": "lists の一覧を名前で指す"
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2
      },
      "description": "1 文字ずつの並び"
    },
    "words": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "pairs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2
      },
      "description": "1 文字 → 1 文字"
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "description": "ICU の正規表現"
    },
    "arrayOps": {
      "type": "object",
      "properties": {
        "$add": {
          "type": "array"
        },
        "$remove": {
          "type": "array"
        },
        "$replace": {
          "type": "array"
        },
        "since": {
          "type": "integer"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "差分: 足す・外す・丸ごと置き換える"
    },
    "orderedOps": {
      "type": "object",
      "properties": {
        "$add": {
          "type": "array"
        },
        "$remove": {
          "type": "array"
        },
        "$replace": {
          "type": "array"
        },
        "at": {
          "enum": [
            "start",
            "end"
          ]
        }
      },
      "additionalProperties": false
    },
    "pairOps": {
      "type": "object",
      "properties": {
        "$set": {
          "$ref": "#/$defs/pairs"
        },
        "$unset": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "$replace": {
          "$ref": "#/$defs/pairs"
        },
        "since": {
          "type": "integer"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "charactersValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/listRef"
        },
        {
          "$ref": "#/$defs/characters"
        },
        {
          "$ref": "#/$defs/arrayOps"
        }
      ]
    },
    "wordsValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/listRef"
        },
        {
          "$ref": "#/$defs/words"
        },
        {
          "$ref": "#/$defs/arrayOps"
        }
      ]
    },
    "pairsValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/listRef"
        },
        {
          "$ref": "#/$defs/pairs"
        },
        {
          "$ref": "#/$defs/pairOps"
        }
      ]
    },
    "patternsValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/patterns"
        },
        {
          "$ref": "#/$defs/arrayOps"
        }
      ]
    },
    "retiredIDs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "廃止した規則の ID(既定値にだけ書く)"
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "旧 ID → 新 ID(既定値にだけ書く)"
    }
  }
}
