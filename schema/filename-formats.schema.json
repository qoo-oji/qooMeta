{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/qoo-oji/qooMeta/main/schema/filename-formats.schema.json",
  "title": "qooMeta のファイル名のフォーマット(第 3 版)",
  "description": "既定値の全体、または base: builtin の差分。説明は docs/rules.md",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "qoometa.filename-formats"
    },
    "schemaVersion": {
      "const": 3
    },
    "revision": {
      "type": "string"
    },
    "base": {
      "const": "builtin",
      "description": "差分のファイルにだけ書く。同梱の既定値に重ねる"
    },
    "retiredIDs": {
      "$ref": "#/$defs/retiredIDs"
    },
    "aliases": {
      "$ref": "#/$defs/aliases"
    },
    "separators": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "著者の値を分ける文字列(既定は , ， 、)"
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "型の並び。上から照合し、名前全体に一致した最初の型で読む。予約語は @title @author @genre @event @source @info @ignore"
    }
  },
  "$defs": {
    "retiredIDs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "廃止した規則の ID(既定値にだけ書く)"
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "旧 ID → 新 ID(既定値にだけ書く)"
    }
  }
}
