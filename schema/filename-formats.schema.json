{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/qoo-oji/qooMeta/main/schema/filename-formats.schema.json",
  "title": "qooMeta のファイル名のフォーマット(第 5 版)",
  "description": "既定値の全体の形。base: builtin の差分は、配列を { \"$add\": [...], \"$remove\": [...], \"at\": \"start\" | \"end\" } か { \"$replace\": [...] } で書く(docs/filename-format.md の 4)",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "qoometa.filename-formats"
    },
    "schemaVersion": {
      "const": 5
    },
    "revision": {
      "type": "string"
    },
    "base": {
      "const": "builtin",
      "description": "差分のファイルにだけ書く。同梱の既定値に重ねる"
    },
    "defaultPreset": {
      "type": "string",
      "minLength": 1,
      "description": "本がプリセットを選ばなかったときに使う名前(presets にある名前)"
    },
    "separators": {
      "$ref": "#/$defs/separators"
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "presets": {
      "type": "object",
      "description": "名前を付けた型の並び。本ごと(実際にはフォルダごと)に選ぶ。名前は自由(利用者は差分で足せる)",
      "propertyNames": {
        "pattern": "^[^$]"
      },
      "additionalProperties": {
        "$ref": "#/$defs/preset"
      }
    },
    "plain": {
      "$ref": "#/$defs/plain"
    }
  },
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formats"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "画面に出す見出し(無ければ名前を出す)"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "画面に出す説明"
        },
        "separators": {
          "$ref": "#/$defs/separators"
        },
        "defaults": {
          "$ref": "#/$defs/defaults"
        },
        "formats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/format"
          },
          "description": "型の並び。上から照合し、名前全体に一致した最初の型で読む"
        },
        "plain": {
          "$ref": "#/$defs/plain"
        },
        "ignoreBracketsInsideTitle": {
          "type": "boolean",
          "description": "題の途中(頭でも末尾でもない所)にある括弧を、読み残しに数えないか。省くと true。型が括弧を欄として読むのは名前の頭・著者の直後・末尾だけなので、途中の括弧は欄になりようがない"
        }
      }
    },
    "format": {
      "description": "1 つの型。文字列か、その型だけの区切り・既定の欄を添えたオブジェクト。予約語は @title @author @genre @event @source @info @series @volume @ignore",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format"
          ],
          "properties": {
            "format": {
              "type": "string",
              "minLength": 1
            },
            "separators": {
              "$ref": "#/$defs/separators"
            },
            "defaults": {
              "$ref": "#/$defs/defaults"
            },
            "plain": {
              "$ref": "#/$defs/plain"
            }
          }
        }
      ]
    },
    "separators": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "著者の値を分ける文字列。ファイル全体 → プリセット → 型 の順に、内側に書いたものが丸ごと置き換える(足し合わせない)"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "名前に書かれていない欄に入れる値。欄ごとに、内側(型 > プリセット > ファイル全体)に書いたものが勝つ。名前から読めた値は上書きしない",
      "properties": {
        "genre": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "info": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "plain": {
      "type": "object",
      "additionalProperties": false,
      "description": "型として読まない文字列。名前の中のこの部分は、型の照合のあいだだけただの文字として扱う(括弧でも型の括弧に当たらない。値には残る)。ファイル全体 → プリセット → 型 と足し合わさる",
      "properties": {
        "words": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "正規表現(ICU)"
        }
      }
    }
  }
}
