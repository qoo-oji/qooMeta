    "markers": {
      "description": "語の規則の並び。並び順が優先順位: 上の規則から順に語を探し、上の規則が取った所には下の規則は反応しない。差分では { \"ID\": {…}, \"$order\": [...] }(新しい ID は先頭に入る)",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^$]"
              },
              "treat": {
                "enum": [
                  "keep",
                  "edition",
                  "source",
                  "compilation",
                  "standalone"
                ],
                "description": "keep = そのまま読む(下の規則から語を守る。例外はこれを上に置いて書く) / edition・source = 版・入手経路の印 / compilation = 総集編の語 / standalone = この語のある本は、どのシリーズにも入れない"
              },
              "since": {
                "type": "integer",
                "minimum": 1
              },
              "required": {
                "type": "boolean"
              },
              "enabled": {
                "type": "boolean"
              },
              "words": {
                "$ref": "#/$defs/wordsValue"
              },
              "patterns": {
                "$ref": "#/$defs/patternsValue"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "treat"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "$order": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
