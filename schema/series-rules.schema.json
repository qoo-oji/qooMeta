                      "roman",
                      "position"
                    ]
                  },
                  "description": "挙げた読み手をこの順で先頭に寄せる"
                },
                "sequel": {
                  "type": "object",
                  "properties": {
                    "since": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "enabled": {
                      "type": "boolean"
                    },
                    "id": {
                      "const": "sequel"
                    },
                    "type": {
                      "const": "sequel"
                    },
                    "words": {
                      "$ref": "#/$defs/wordsValue"
                    }
                  },
                  "additionalProperties": false
                },
                "kanjiAlone": {
                  "type": "object",
                  "properties": {
                    "since": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "enabled": {
                      "type": "boolean"
                    },
                    "id": {
                      "const": "kanjiAlone"
                    },
                    "type": {
                      "const": "kanjiAloneNumeral"
                    },
                    "digits": {
                      "$ref": "#/$defs/wordsValue"
                    }
                  },
                  "additionalProperties": false
                },
                "wordNumber": {
                  "type": "object",
                  "properties": {
                    "since": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "enabled": {
                      "type": "boolean"
                    },
                    "id": {
                      "const": "wordNumber"
                    },
                    "type": {
                      "const": "numberWord"
                    },
                    "words": {
                      "$ref": "#/$defs/wordPairsValue"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "followers": {
          "type": "object",
          "properties": {
            "since": {
              "type": "integer",
              "minimum": 1
            },
            "required": {
              "type": "boolean"
            },
            "characters": {
              "$ref": "#/$defs/charactersValue"
            }
          },
          "additionalProperties": false
        },
        "inference": {
          "type": "object",
          "properties": {
            "sharedLeadingKanji": {
              "type": "object",
              "properties": {
                "since": {
                  "type": "integer",
                  "minimum": 1
                },
                "required": {
                  "type": "boolean"
                },
                "enabled": {
                  "type": "boolean"
                },
                "minBooks": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 10
                }
              },
              "additionalProperties": false
            },
            "firstVolume": {
              "type": "object",
              "properties": {
                "since": {
                  "type": "integer",
                  "minimum": 1
                },
                "required": {
                  "type": "boolean"
                },
                "excludeMarkers": {
                  "$ref": "#/$defs/wordsValue"
                },
                "excludePrefixes": {
                  "$ref": "#/$defs/wordsValue"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "listRef": {
      "type": "string",
      "pattern": "^@list:[A-Za-z0-9]+$",
      "description": "lists の一覧を名前で指す"
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2
      },
      "description": "1 文字ずつの並び"
    },
    "words": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "pairs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2
      },
      "description": "1 文字 → 1 文字"
    },
    "wordPairs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "description": "語 → 語(ひらがなの数え方 → 数字)"
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "description": "ICU の正規表現"
    },
    "arrayOps": {
      "type": "object",
      "properties": {
        "$add": {
          "type": "array"
        },
        "$remove": {
          "type": "array"
        },
        "$replace": {
          "type": "array"
        },
        "since": {
          "type": "integer"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "差分: 足す・外す・丸ごと置き換える"
    },
    "orderedOps": {
      "type": "object",
      "properties": {
        "$add": {
          "type": "array"
        },
        "$remove": {
          "type": "array"
        },
        "$replace": {
          "type": "array"
        },
        "at": {
          "enum": [
            "start",
            "end"
          ]
        }
      },
      "additionalProperties": false
    },
    "pairOps": {
      "type": "object",
      "properties": {
        "$set": {
          "$ref": "#/$defs/pairs"
        },
        "$unset": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "$replace": {
          "$ref": "#/$defs/pairs"
        },
        "since": {
          "type": "integer"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "charactersValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/listRef"
        },
        {
          "$ref": "#/$defs/characters"
        },
        {
          "$ref": "#/$defs/arrayOps"
        }
      ]
    },
    "wordsValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/listRef"
        },
        {
          "$ref": "#/$defs/words"
        },
        {
          "$ref": "#/$defs/arrayOps"
        }
      ]
    },
    "pairsValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/listRef"
        },
        {
          "$ref": "#/$defs/pairs"
        },
        {
          "$ref": "#/$defs/pairOps"
        }
      ]
    },
    "wordPairsValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/listRef"
        },
        {
          "$ref": "#/$defs/wordPairs"
        },
        {
          "$ref": "#/$defs/pairOps"
        }
      ]
    },
    "patternsValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/patterns"
        },
        {
          "$ref": "#/$defs/arrayOps"
        }
      ]
    },
    "retiredIDs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "廃止した規則の ID(既定値にだけ書く)"
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "旧 ID → 新 ID(既定値にだけ書く)"
    }
  }
}
