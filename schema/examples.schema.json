{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/qoo-oji/qooMeta/main/schema/examples.schema.json",
  "title": "qooMeta の例のファイル",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "examples"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "qoometa.examples"
    },
    "schemaVersion": {
      "const": 2
    },
    "revision": {
      "type": "string"
    },
    "vocabulary": {
      "$ref": "#/$defs/vocabulary"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "files",
          "expect"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "folders": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          },
          "expect": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "series": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "volume": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "circle": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "relation": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "genre": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "event": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "volumeSort": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "inferred": {
                  "type": "boolean"
                },
                "authors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "editions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "vocabulary": {
            "$ref": "#/$defs/vocabulary"
          }
        }
      }
    }
  },
  "$defs": {
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "genres": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
