    "A book on its own is given volume 1, or is not": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A book on its own is given volume 1, or is not"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シリーズに 1 冊しかない本の巻数"
          }
        }
      }
    },
    "A book put in the main series falls back to “X Compilation” when no main series was found — with one compilation enough to make it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A book put in the main series falls back to “X Compilation” when no main series was found — with one compilation enough to make it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「本編のシリーズに入れる」を選んでも、本編のシリーズが見つからない本は「X 総集編」になります(そのときは 1 冊でもシリーズにします)。"
          }
        }
      }
    },
    "A book whose title holds one of these joins no series. The bundled list is empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A book whose title holds one of these joins no series. The bundled list is empty"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この語のあるタイトルの本は、どのシリーズにも入れません(標準の一覧は空です)"
          }
        }
      }
    },
    "A book whose title holds one of these joins no series. To leave out a single book, write its title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A book whose title holds one of these joins no series. To leave out a single book, write its title"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この語のあるタイトルの本は、どのシリーズにも入れません。1 冊だけ外すなら、そのタイトルを書いてください"
          }
        }
      }
    },
    "A book whose title holds this word joins no series": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A book whose title holds this word joins no series"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この語のある本は、どのシリーズにも入れません"
          }
        }
      }
    },
    "A book with this word after the series name": {
      "extractionState": "manual",
      "localizations": {
