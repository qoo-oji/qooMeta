            "state": "translated",
            "value": "シリーズ名より後ろにこの語がある本"
          }
        }
      }
    },
    "A book with this word after the series name is not volume 1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A book with this word after the series name is not volume 1"
