{
  "$schema": "https://raw.githubusercontent.com/qoo-oji/qooMeta/main/schema/filename-formats.schema.json",
  "kind": "qoometa.filename-formats",
  "schemaVersion": 5,
  "revision": "2026.09.20.4",
  "defaultPreset": "mixed",
  "separators": [
    ",",
    "，",
    "、"
  ],
  "plain": {
    "words": [],
    "patterns": ["[(（](?:19|20)\\d{2}年?[)）]"]
  },
  "presets": {
    "mixed": {
      "label": "混ざった蔵書",
      "note": "同人誌と商業誌の命名が混ざった蔵書をそのまま読む。数字だけの末尾の丸括弧は巻数、そうでなければ原作",
      "formats": [
        "(@genre) [@author (@author)] @title (@volume) [@info]",
        "(@genre) [@author (@author)] @title (@volume)",
        "(@genre) [@author (@author)] @title (@source) [@info]",
        "(@genre) [@author (@author)] @title (@source)",
        "(@genre) [@author (@author)] @title [@info]",
        "(@genre) [@author (@author)] @title",
        "(@genre) [@author] @title (@volume) [@info]",
        "(@genre) [@author] @title (@volume)",
        "(@genre) [@author] @title (@source) [@info]",
        "(@genre) [@author] @title (@source)",
        "(@genre) [@author] @title [@info]",
        "(@genre) [@author] @title",
        "[@author (@author)] @title (@volume) [@info]",
        "[@author (@author)] @title (@volume)",
        "[@author (@author)] @title (@source) [@info]",
        "[@author (@author)] @title (@source)",
        "[@author (@author)] @title [@info]",
        "[@author (@author)] @title",
        "[@author] @title (@volume) [@info]",
        "[@author] @title (@volume)",
        "[@author] @title (@source) [@info]",
        "[@author] @title (@source)",
        "[@author] @title [@info]",
        "[@author] @title",
        "@series (@volume) - @author [@info]",
        "@series (@volume) - @author"
      ]
    },
    "doujinshi": {
      "label": "同人誌(先頭の丸括弧はジャンル)",
      "note": "末尾の丸括弧は原作。角括弧の中の丸括弧は 2 人目からの著者",
      "formats": [
        "(@genre) [@author (@author)] @title (@source) [@info]",
        "(@genre) [@author (@author)] @title (@source)",
        "(@genre) [@author (@author)] @title [@info]",
        "(@genre) [@author (@author)] @title",
        "(@genre) [@author] @title (@source) [@info]",
        "(@genre) [@author] @title (@source)",
        "(@genre) [@author] @title [@info]",
        "(@genre) [@author] @title",
        "[@author (@author)] @title (@source) [@info]",
        "[@author (@author)] @title (@source)",
        "[@author (@author)] @title [@info]",
        "[@author (@author)] @title",
        "[@author] @title (@source) [@info]",
        "[@author] @title (@source)",
        "[@author] @title [@info]",
        "[@author] @title"
      ]
    },
    "doujinshi-event": {
      "label": "同人誌(先頭の丸括弧は催し)",
      "note": "先頭の丸括弧を頒布会の名前として読む。名前に書かれないジャンルは既定で入れる",
      "defaults": {
        "genre": "同人誌"
      },
      "formats": [
        "(@event) [@author (@author)] @title (@source) [@info]",
        "(@event) [@author (@author)] @title (@source)",
        "(@event) [@author (@author)] @title [@info]",
        "(@event) [@author (@author)] @title",
        "(@event) [@author] @title (@source) [@info]",
        "(@event) [@author] @title (@source)",
        "(@event) [@author] @title [@info]",
        "(@event) [@author] @title",
        "[@author (@author)] @title (@source) [@info]",
        "[@author (@author)] @title (@source)",
        "[@author (@author)] @title [@info]",
        "[@author (@author)] @title",
        "[@author] @title (@source) [@info]",
        "[@author] @title (@source)",
        "[@author] @title [@info]",
        "[@author] @title"
      ]
    },
    "commercial": {
      "label": "商業誌",
      "note": "末尾の丸括弧は巻数(数字だけ)。「シリーズ名 (巻数) - 著者」の形も読む",
      "formats": [
        "(@genre) [@author] @title (@volume) [@info]",
        "(@genre) [@author] @title (@volume)",
        "(@genre) [@author] @title [@info]",
        "(@genre) [@author] @title",
        "[@author] @title (@volume) [@info]",
        "[@author] @title (@volume)",
        "[@author] @title [@info]",
        "[@author] @title",
        "@series (@volume) - @author [@info]",
        "@series (@volume) - @author"
      ]
    }
  }
}
